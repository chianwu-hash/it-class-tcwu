  "rules": [
    {
      "id": "choice",
      "version": 1,
      "label": "是非、選擇與原圖選答",
      "sourceRoles": [
        "是非",
        "單選",
        "只勾一個選項（含圖）",
        "複選",
        "句中圈選",
        "原圖選答"
      ],
      "transform": "完整擷取原選項與ID；單一目標用single，多目標才用fields；保留原序與圖文",
      "sourceBinding": "從固定選項選一個答案一律使用單選，含圈選、勾選、貼圖和圖案規律。依原標號、選項文字或唯一吻合的教師圖鍵綁定正解。有 Word 裁切或翻轉時，先按每次出現還原顯示。選項圖隨原選項，共用圖按原圖文順序留在題幹。",
      "explanation": "依選項內容說明理由，不用A/B位置指稱，不重複是非符號",
      "mustPreserve": [
        "原選項與答案映射",
        "未作答與明示全不選",
        "原圖完整性"
      ],
      "mainModules": [
        "shared/quiz-choice.mjs",
        "shared/quiz-choice-conversion.mjs",
        "shared/quiz-answer-templates.mjs"
      ],
      "draftModules": [
        "shared/quiz-image-choices.mjs"
      ],
      "availability": "existing_contracts_with_guarded_draft_image_variants"
    },
    {
